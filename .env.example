# ============================================================
# Environment Configuration Template — BMBK Stripmap
# ============================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env

# --- Konfigurasi Aplikasi ---
APP_NAME="Strip Map Ruas Jalan"

# Local Development:
# APP_URL=http://localhost/bmbk-stripmap/public/
# APP_DEBUG=true

# Production (stripmap.bmbklampung.com):
APP_URL=https://stripmap.bmbklampung.com/
APP_DEBUG=false

APP_TIMEZONE=Asia/Jakarta

# --- Konfigurasi Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stripmap_db
DB_USER=root
DB_PASS=

# Catatan untuk Production (cPanel):
# - DB_NAME & DB_USER biasanya memiliki prefix username cPanel (contoh: bmbk_stripmap_db)
# - Pastikan APP_DEBUG selalu bernilai false di server publik/production
# - Pastikan APP_URL menggunakan protokol https://
